# GridTwin API — SERVER-SIDE ONLY.
# Never expose these values to the browser or commit real values to git.

# Runtime
PORT=4000
NODE_ENV=development

# CORS origin allowlist (Phase 2)
FRONTEND_URL=http://localhost:3000

# Supabase Configuration (Server-side service-role access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_INPUT_CHARS=2000
GEMINI_MAX_OUTPUT_TOKENS=500
