# GridTwin API — SERVER-SIDE ONLY.
# Never expose these values to the browser or commit real values to git.

# Runtime
PORT=4000
NODE_ENV=development

# CORS origin allowlist (Phase 2)
FRONTEND_URL=http://localhost:3000

# Supabase (Phase 3) — the service role key bypasses RLS and must stay server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Phase 17) — server-side only.
GEMINI_API_KEY=
