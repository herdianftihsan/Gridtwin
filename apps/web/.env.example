# GridTwin Web — BROWSER-SAFE VARIABLES ONLY.
# NEVER place Supabase service-role keys, anon-only keys, or Gemini keys here.
# Anything prefixed with NEXT_PUBLIC_ is shipped to the browser.

# Base URL of the GridTwin API (backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project URL for Supabase Auth client usage (public by design).
# The anon key is also public by design; the service-role key must NEVER appear here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
