{
  "name": "gridtwin",
  "version": "0.1.0",
  "private": true,
  "description": "GRIDTWIN AI — Energy Decision Platform for Building Owners",
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @gridtwin/api dev",
    "dev:web": "pnpm --filter @gridtwin/web dev",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @gridtwin/shared build && pnpm --filter @gridtwin/shared --filter @gridtwin/api --filter @gridtwin/web run typecheck",
    "test": "pnpm --filter @gridtwin/shared build && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.2.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
